{
	# While testing, uncomment the line below to use Let's Encrypt's staging
	# CA. It issues untrusted test certs but has much higher rate limits, so
	# repeated `docker compose up --build` runs while iterating won't burn
	# through the production "duplicate certificate" limit (5 per week for
	# the same set of hostnames). Remove/comment out once everything works.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

vault.tariqbk.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
	reverse_proxy vaultwarden:80
}

immich.tariqbk.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
	reverse_proxy immich-server:2283
}

links.tariqbk.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
	reverse_proxy linkding:9090
}

jellyfin.tariqbk.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_DNS_API_TOKEN}
	}
	reverse_proxy jellyfin:8096
}

# ── Local .home services (HTTP only, LAN access) ──────────────────────────────

http://glances.home {
	reverse_proxy host.docker.internal:61208
}

http://ha.home {
	reverse_proxy host.docker.internal:8123
}

http://pihole.home {
	redir / /admin 302
	reverse_proxy host.docker.internal:8880
}

http://portainer.home {
	reverse_proxy https://host.docker.internal:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Catch-all: any HTTP request not matched above goes to Pi-hole.
# This preserves the ad-block redirect page — blocked domains resolve to
# the Pi's IP, the browser hits port 80, and Caddy forwards it to Pi-hole.
http:// {
	reverse_proxy host.docker.internal:8880
}
